{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter dotty-botty-site build",
  "outputDirectory": "site/dist",
  "framework": null,
  "redirects": [{ "source": "/", "destination": "/dotty/", "permanent": false }],
  "rewrites": [{ "source": "/dotty", "destination": "/dotty/index.html" }]
}
