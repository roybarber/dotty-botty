{
  "name": "dotty-botty",
  "version": "0.1.0",
  "description": "Dotty, a tiny procedural SVG character for your agents and generative UI. React, 27 shapes, 12 expressions, 9 animated states, no dependencies.",
  "license": "MIT",
  "author": "Roy Barber",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roybarber/dotty-botty.git",
    "directory": "packages/dotty-botty"
  },
  "homepage": "https://dotty.roybarber.com",
  "bugs": "https://github.com/roybarber/dotty-botty/issues",
  "keywords": ["react", "svg", "animation", "character", "mascot", "avatar", "agent", "ai", "generative-ui", "loader"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run build"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3"
  }
}
